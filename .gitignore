# Пароль домашней сети — на плате он нужен, в репозитории ему не место.
# Репозиторий должен быть публичным: OTA тянет файлы через
# raw.githubusercontent.com и jsDelivr, а они приватные репозитории без
# токена не отдают.
wifi_config.json

# Версия, установленная на плате, — её состояние, не исходник.
ota_version.txt

# Снимки и прошивка MicroPython: первое — данные, второе — бинарник на
# 2 МБ, который через OTA всё равно не обновляется.
photos/
firmware/
*.bmp
*.gray

__pycache__/
*.pyc
.DS_Store
